#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

dnf update -y
dnf install -y python3 python3-pip

mkdir -p /opt/cloud-file-manager/templates
echo '${app_py_b64}' | base64 -d > /opt/cloud-file-manager/app.py
echo '${index_html_b64}' | base64 -d > /opt/cloud-file-manager/templates/index.html
cat > /opt/cloud-file-manager/requirements.txt <<'EOF'
Flask>=3.0,<4.0
boto3>=1.34,<2.0
PyMySQL>=1.1,<2.0
gunicorn>=22.0,<24.0
EOF

python3 -m pip install --no-cache-dir -r /opt/cloud-file-manager/requirements.txt

cat > /etc/cloud-file-manager.env <<'EOF'
S3_BUCKET=${s3_bucket}
DB_HOST=${db_host}
DB_NAME=${db_name}
DB_USER=${db_username}
DB_PASSWORD=${db_password}
MAX_UPLOAD_MB=${max_upload_mb}
EOF
chmod 600 /etc/cloud-file-manager.env

cat > /etc/systemd/system/cloud-file-manager.service <<'EOF'
[Unit]
Description=Cloud File Manager Flask application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cloud-file-manager
EnvironmentFile=/etc/cloud-file-manager.env
ExecStart=/usr/bin/python3 -m gunicorn --workers 2 --bind 0.0.0.0:80 app:app
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now cloud-file-manager
