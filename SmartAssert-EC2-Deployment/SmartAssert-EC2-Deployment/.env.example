# Copy to .env and set secrets before starting. Never commit/share .env.
DB_NAME=postgres
DB_USER=smartadmin
DB_PASSWORD=CHANGE_ME_TO_RDS_PASSWORD
DB_POOL_MAX=5
DB_SSL=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=SmartAssert Administrator
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_UNIQUE_PASSWORD
ADMIN_OVERWRITE=false
BOOTSTRAP_ADMIN=true
