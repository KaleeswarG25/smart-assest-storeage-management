{
  "name": "asset-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Cloud-Based IT Asset Lifecycle and Software License Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate-pg": "node src/db/migrateSqliteToPostgres.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "admin:create": "node src/scripts/createAdmin.js",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "asset-management",
    "license-management",
    "express",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
