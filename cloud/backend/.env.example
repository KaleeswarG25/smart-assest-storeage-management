# SmartAssert production configuration (copy to .env and fill in your values)
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://YOUR_EC2_PUBLIC_DNS_OR_DOMAIN
COOKIE_SAMESITE=lax

# Amazon RDS for PostgreSQL
DB_ENGINE=postgres
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=asset_management
DB_USER=asset_app_user
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DB_POOL_MAX=5
DB_SSL=true

# Amazon S3 (EC2 instance role provides credentials; do not add access keys here)
STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
S3_BUCKET_NAME=YOUR_UNIQUE_PRIVATE_BUCKET_NAME
S3_MAX_UPLOAD_BYTES=15728640
S3_SSE=AES256
